# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit it.

# Reddit API (required for 01_collect_reddit.py)
# Create an app at https://www.reddit.com/prefs/apps — choose "script" type
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=llm-investor-sim/0.1

# Optional: Hugging Face token (removes rate-limit warnings when downloading SBERT)
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: suppress the Windows symlink warning from huggingface_hub
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Optional: OpenAI or Anthropic key if you add LLM-agent simulation later
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
